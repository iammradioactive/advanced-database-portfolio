digraph ER {
graph [rankdir=LR, bgcolor="white", nodesep=0.35, ranksep=0.75, pad=0.25];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans",fontsize=9,color="#64748b",arrowsize=0.7];
categories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK category_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">category_name : TEXT</FONT></TD></TR></TABLE>>];
customer_addresses [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>customer_addresses</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK FK customer_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK address_no : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">address_line : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">city : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">state : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">country_code : TEXT</FONT></TD></TR></TABLE>>];
customers -> customer_addresses [label="1 : 0..*", arrowhead=none];
customers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK customer_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">first_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">last_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">email : TEXT</FONT></TD></TR></TABLE>>];
inventory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>inventory</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK FK warehouse_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK FK product_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">on_hand : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">reserved : INTEGER</FONT></TD></TR></TABLE>>];
products -> inventory [label="1 : 0..*", arrowhead=none];
warehouses -> inventory [label="1 : 0..*", arrowhead=none];
order_items [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK FK order_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK line_no : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK product_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">quantity : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">unit_price_kobo : INTEGER</FONT></TD></TR></TABLE>>];
products -> order_items [label="1 : 0..*", arrowhead=none];
orders -> order_items [label="1 : 0..*", arrowhead=none];
orders [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK order_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK customer_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK shipping_address_no : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK warehouse_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">delivery_fee_kobo : INTEGER</FONT></TD></TR></TABLE>>];
customer_addresses -> orders [label="1 : 0..*", arrowhead=none];
warehouses -> orders [label="1 : 0..*", arrowhead=none];
customers -> orders [label="1 : 0..*", arrowhead=none];
outbox [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>outbox</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK event_id : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">aggregate_type : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">aggregate_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">event_type : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">payload_json : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">occurred_at : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">processed_at : TEXT</FONT></TD></TR></TABLE>>];
payment_attempts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>payment_attempts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK payment_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK order_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">provider_reference : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">amount_kobo : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">attempted_at : TEXT</FONT></TD></TR></TABLE>>];
orders -> payment_attempts [label="1 : 0..*", arrowhead=none];
products [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK product_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sku : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">product_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK category_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">unit_price_kobo : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">active : INTEGER</FONT></TD></TR></TABLE>>];
categories -> products [label="1 : 0..*", arrowhead=none];
shipments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>shipments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK shipment_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK order_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tracking_reference : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">carrier : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">shipped_at : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">delivered_at : TEXT</FONT></TD></TR></TABLE>>];
orders -> shipments [label="1 : 0..1", arrowhead=none];
warehouses [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#16324f"><FONT COLOR="white"><B>warehouses</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">PK warehouse_id : INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">warehouse_code : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">warehouse_name : TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">city : TEXT</FONT></TD></TR></TABLE>>];
outbox [xlabel="Logical event reference; not an SQL FK"];
}